# Copy this file to `.env` (local development) or `.env.production`
# (production build) and adjust the value. The real files are git-ignored.
#
#   cp .env.example .env
#
# Base URL of the CampusEats backend, with NO trailing slash.
# Leave empty to serve the bundled static data from public/menu.json instead.
#
# Local dev -- matches the ASP.NET launchSettings profile "http":
VITE_API_URL=http://localhost:5148

# Production -- replace with your deployed API host:
# VITE_API_URL=https://campuseats-api.onrender.com
#
# IMPORTANT: Vite inlines VITE_* variables at build time, so run `npm run build`
# again after changing this value.